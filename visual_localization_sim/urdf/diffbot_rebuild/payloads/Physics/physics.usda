#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "diffbot"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "diffbot"
{
    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
        )
        {
            double[] newton:inertia = [0.013, 0.015249999999999998, 0.01025, 0, 0, 0]
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.01025, 0.013, 0.01525)
            float physics:mass = 0.3
            quatf physics:principalAxes = (-0.5, 0.5, 0.5, 0.5)

            over "left_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.001616875, 0.00273375, 0.001616875, 0, 0, -2.4799606812564435e-19]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.001616875, 0.001616875, 0.00273375)
                float physics:mass = 0.3
                quatf physics:principalAxes = (0.70710677, 0.70710677, 0, 0)

                over "cylinder_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "right_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.001616875, 0.00273375, 0.001616875, 0, 0, -2.4799606812564435e-19]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.001616875, 0.001616875, 0.00273375)
                float physics:mass = 0.3
                quatf physics:principalAxes = (0.70710677, 0.70710677, 0, 0)

                over "cylinder_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "front_left_caster" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.000050000000000000016, 0.000050000000000000016, 0.000050000000000000016, 0, 0, 0]
                float3 physics:diagonalInertia = (0.00005, 0.00005, 0.00005)
                float physics:mass = 0.05
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "sphere_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "front_right_caster" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.000050000000000000016, 0.000050000000000000016, 0.000050000000000000016, 0, 0, 0]
                float3 physics:diagonalInertia = (0.00005, 0.00005, 0.00005)
                float physics:mass = 0.05
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "sphere_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "rear_left_caster" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.000050000000000000016, 0.000050000000000000016, 0.000050000000000000016, 0, 0, 0]
                float3 physics:diagonalInertia = (0.00005, 0.00005, 0.00005)
                float physics:mass = 0.05
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "sphere_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "rear_right_caster" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.000050000000000000016, 0.000050000000000000016, 0.000050000000000000016, 0, 0, 0]
                float3 physics:diagonalInertia = (0.00005, 0.00005, 0.00005)
                float physics:mass = 0.05
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "sphere_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "velodyne" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.001, 0.001, 0.001, 0, 0, 0]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
                float physics:mass = 0.114
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "cylinder_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "box_1" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "left_wheel_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 100
            float newton:damping = 0.0034906585
            float newton:velocityLimit = 286.4789
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </diffbot/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link/left_wheel>
            point3f physics:localPos0 = (0, 0.265, -0.265)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:limit:effort = 100
        }

        def PhysicsRevoluteJoint "right_wheel_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 100
            float newton:damping = 0.0034906585
            float newton:velocityLimit = 286.4789
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </diffbot/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link/right_wheel>
            point3f physics:localPos0 = (0, -0.265, -0.265)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:limit:effort = 100
        }

        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </diffbot>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "front_left_caster_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </diffbot/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link/front_left_caster>
            point3f physics:localPos0 = (0.2, 0.15, -0.345)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "front_right_caster_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </diffbot/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link/front_right_caster>
            point3f physics:localPos0 = (0.2, -0.15, -0.345)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "rear_left_caster_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </diffbot/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link/rear_left_caster>
            point3f physics:localPos0 = (-0.2, 0.15, -0.345)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "rear_right_caster_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </diffbot/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link/rear_right_caster>
            point3f physics:localPos0 = (-0.2, -0.15, -0.345)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "scan_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </diffbot/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </diffbot/Geometry/base_link/velodyne>
            point3f physics:localPos0 = (0, 0, 0.065)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

