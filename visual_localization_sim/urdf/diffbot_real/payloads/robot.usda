#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "diffbot"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "diffbot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </diffbot/Physics/root_joint>,
        </diffbot/Physics/left_wheel_joint>,
        </diffbot/Physics/right_wheel_joint>,
        </diffbot/Physics/scan_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </diffbot/Geometry/base_link>,
        </diffbot/Geometry/base_link/left_wheel>,
        </diffbot/Geometry/base_link/right_wheel>,
        </diffbot/Geometry/base_link/velodyne>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "right_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "velodyne" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "imu_link" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "scan_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

